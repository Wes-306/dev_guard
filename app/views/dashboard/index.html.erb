<!-- app/views/dashboard/index.html.erb -->
<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
  <% if flash[:notice] %>
    <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded-md">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Dashboard DevGuard</h1>

    <!-- Form com método DELETE para acionar o logout_path -->
    <%= button_to "Sair", logout_path, method: :delete, class: "px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-md text-sm cursor-pointer" %>
  </div>
</div>